{
  "name": "marketing-copilot",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b && npm run typecheck -w @mcopilot/web",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "build:web": "npm run build -w @mcopilot/web",
    "build": "tsc -b && npm run build -w @mcopilot/web",
    "package:functions": "node scripts/package-functions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
